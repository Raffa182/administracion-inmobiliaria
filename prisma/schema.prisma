// Prisma schema - Gestión Inmobiliaria (multi-tenant)
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AGENTE
  SUPERADMIN
}

// Registro de acciones del super admin sobre las inmobiliarias. No usa
// relaciones (FK) a Tenant/User a propósito: debe sobrevivir si el tenant o
// el usuario referido se borran, para conservar el historial.
model AdminAuditLog {
  id                String   @id @default(cuid())
  actorUserId       String
  actorEmail        String
  action            String
  targetTenantId    String?
  targetTenantSlug  String?
  targetTenantName  String?
  targetUserEmail   String?
  details           String?
  createdAt         DateTime @default(now())

  @@index([createdAt])
}

enum PortalPersonType {
  RENTER
  BUYER
}

// Token de acceso al portal del inquilino/comprador (login por magic link,
// sin contraseña). Se guarda hasheado, de un solo uso, con vencimiento corto.
model PortalLoginToken {
  id         String           @id @default(cuid())
  tenantId   String
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  personType PortalPersonType
  personId   String
  tokenHash  String           @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime         @default(now())

  @@index([tenantId])
}

enum ContractStatus {
  ACTIVO
  FINALIZADO
  RESCINDIDO
}

// Larga temporada: alquiler habitual (LAU, mínimo de temporalidad legal).
// Temporada: alquiler vacacional/de corta duración.
enum ContractType {
  LARGA_TEMPORADA
  TEMPORADA
}

enum ExpenseType {
  IBI
  BASURA
  ARREGLO
  COMUNIDAD
  SEGURO
  OTRO
}

enum PaymentStatus {
  PENDIENTE
  PAGADO
  VENCIDO
}

enum ReservationStatus {
  ACTIVA
  CONVERTIDA
  CANCELADA
}

// Qué se hace con la propiedad: se ofrece en alquiler, en venta, o ambas.
enum ListingType {
  ALQUILER
  VENTA
  ALQUILER_Y_VENTA
}

enum SaleStatus {
  DISPONIBLE
  RESERVADA
  VENDIDA
  CANCELADA
}

enum LeadStage {
  NUEVO
  CONTACTADO
  VISITA_AGENDADA
  NEGOCIANDO
  CERRADO
  PERDIDO
}

enum LeadSource {
  WEB
  IDEALISTA
  FOTOCASA
  TELEFONO
  REFERIDO
  OTRO
}

// Interesado en una propiedad, antes de convertirse en inquilino/comprador
// (Reserva/Contrato/Venta). El pipeline es manual: el agente mueve el lead
// de etapa a medida que avanza la conversación.
model Lead {
  id         String     @id @default(cuid())
  tenantId   String
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  email      String?
  propertyId String?
  property   Property?  @relation(fields: [propertyId], references: [id])
  source     LeadSource @default(OTRO)
  stage      LeadStage  @default(NUEVO)
  notes      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  visits     Visit[]

  @@index([tenantId])
  @@index([stage])
}

// Visita agendada a una propiedad. Puede venir de un lead del CRM o
// cargarse directamente (por ejemplo, alguien que llamó y no pasó por
// el pipeline).
model Visit {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId          String?
  lead            Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id])
  scheduledAt     DateTime
  durationMinutes Int      @default(30)
  notes           String?
  createdAt       DateTime @default(now())

  @@index([tenantId])
  @@index([scheduledAt])
}

// Documentación personal de un inquilino o comprador.
enum PersonDocumentType {
  DNI
  NOMINA
  CONTRATO_TRABAJO
  OTRO
}

// Documentación de la propiedad en sí (no ligada a una persona).
enum PropertyDocumentType {
  ESCRITURA
  OTRO
}

enum PropertyPhotoType {
  PROPIEDAD
  LLAVE
}

// Cada Tenant representa una inmobiliaria / cliente de la plataforma.
// El aislamiento de datos es lógico (tenantId en cada tabla); ver README
// para la estrategia de escalado a bases de datos físicas separadas.
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  logoFileName String?
  logoFileData String? // base64 (mismo criterio MVP que el resto de los archivos)
  createdAt DateTime @default(now())

  users         User[]
  properties    Property[]
  renters       Renter[]
  owners        Owner[]
  buyers        Buyer[]
  contracts     Contract[]
  reservations  Reservation[]
  sales         Sale[]
  expenses      Expense[]
  payments      Payment[]
  personDocs    PersonDocument[]
  propertyDocs  PropertyDocument[]
  propertyPhotos PropertyPhoto[]
  portalLoginTokens PortalLoginToken[]
  leads         Lead[]
  visits        Visit[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  name         String
  role         Role     @default(ADMIN)
  emailVerified DateTime?
  createdAt    DateTime @default(now())

  // Verificación en dos pasos (TOTP). twoFactorSecret se guarda ni bien se
  // genera el QR pero twoFactorEnabled queda en false hasta confirmar el
  // primer código; así un setup abandonado nunca llega a exigirse en el
  // login. twoFactorBackupCodes es un JSON de hashes bcrypt, uno por código
  // de respaldo sin usar (se van quitando de la lista al consumirse).
  twoFactorSecret      String?
  twoFactorEnabled     Boolean  @default(false)
  twoFactorBackupCodes String?

  @@unique([tenantId, email])
  @@index([email])
}

model Owner {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())

  properties Property[]

  @@index([tenantId])
}

model Renter {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  dni       String?
  email     String?
  phone     String?
  createdAt DateTime @default(now())

  contracts    Contract[]
  reservations Reservation[]
  documents    PersonDocument[]

  @@index([tenantId])
}

// Comprador de una propiedad en venta.
model Buyer {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  dni       String?
  email     String?
  phone     String?
  createdAt DateTime @default(now())

  sales     Sale[]
  documents PersonDocument[]

  @@index([tenantId])
}

// Ficha de la propiedad: datos que existen independientemente de que haya
// (o no) un contrato de alquiler o una venta en curso.
model Property {
  id          String      @id @default(cuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  address     String
  unit        String?
  city        String?
  type        String      @default("Piso")
  ownerId     String?
  owner       Owner?      @relation(fields: [ownerId], references: [id])

  listingType ListingType @default(ALQUILER)

  // Ficha
  squareMeters        Float?
  rooms               Int?
  petsAllowed         Boolean? // se aceptan mascotas
  appliancesIncluded  Boolean? // tiene electrodomésticos
  furnished           Boolean? // está equipada/amueblada
  hasParking          Boolean? // tiene plaza de parking
  inUrbanizacion      Boolean  @default(false)
  complexName         String?  // nombre de la urbanización, si aplica
  askingRent          Float?   // precio de alquiler pedido (ficha, antes de tener contrato)
  askingSale          Float?   // precio de venta pedido (ficha, antes de tener venta)
  notes               String?

  createdAt   DateTime @default(now())

  contracts     Contract[]
  reservations  Reservation[]
  sales         Sale[]
  expenses      Expense[]
  documents     PropertyDocument[]
  photos        PropertyPhoto[]
  leads         Lead[]
  visits        Visit[]

  @@index([tenantId])
}

// Reserva: paso previo al contrato de alquiler. Incluye una seña/honorario
// (normalmente el equivalente a una mensualidad) y, si se concreta, se
// convierte en un Contract.
model Reservation {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId  String
  property    Property          @relation(fields: [propertyId], references: [id])
  renterId    String
  renter      Renter            @relation(fields: [renterId], references: [id])

  reservationDate DateTime
  amount          Float         // seña / honorarios de la inmobiliaria
  status          ReservationStatus @default(ACTIVA)
  notes           String?

  contractId  String?  @unique
  contract    Contract? @relation(fields: [contractId], references: [id])

  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([propertyId])
}

// Alquiler
model Contract {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId  String
  property    Property       @relation(fields: [propertyId], references: [id])
  renterId    String
  renter      Renter         @relation(fields: [renterId], references: [id])

  contractType ContractType  @default(LARGA_TEMPORADA)

  startDate   DateTime
  endDate     DateTime
  rentAmount  Float
  // En España la actualización anual según IPC (INE) es lo habitual (LAU)
  adjustmentFrequencyMonths Int      @default(12)
  nextAdjustmentDate        DateTime?
  status      ContractStatus @default(ACTIVO)

  // Contrato digitalizado (PDF escaneado / firmado subido por el usuario)
  contractFileName String?
  contractFileData  String? // data URL / base64 (MVP: almacenado en DB; ver README para migrar a storage externo)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  expenses    Expense[]
  payments    Payment[]
  reservation Reservation?

  @@index([tenantId])
  @@index([propertyId])
  @@index([renterId])
}

// Venta de una propiedad.
model Sale {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId  String
  property    Property   @relation(fields: [propertyId], references: [id])
  buyerId     String?
  buyer       Buyer?     @relation(fields: [buyerId], references: [id])

  price       Float
  status      SaleStatus @default(DISPONIBLE)
  saleDate    DateTime?
  notes       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([propertyId])
}

// IBI, basura, arreglos, comunidad, etc. asociados a un contrato o
// directamente a una propiedad (también sirve para ventas, vía propertyId).
model Expense {
  id          String      @id @default(cuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contractId  String?
  contract    Contract?   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  propertyId  String?
  property    Property?   @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  type        ExpenseType
  description String
  amount      Float
  date        DateTime
  receiptFileName String?
  receiptFileData  String? // recibo escaneado (IBI, basura, etc.), base64

  createdAt   DateTime    @default(now())

  @@index([tenantId])
  @@index([contractId])
}

// Pago mensual de alquiler -> al marcarse PAGADO se genera un recibo en PDF
model Payment {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contractId  String
  contract    Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)

  period      String        // "2026-09"
  amount      Float
  dueDate     DateTime
  paidDate    DateTime?
  status      PaymentStatus @default(PENDIENTE)
  receiptFileName String?
  receiptFileData  String?  // PDF generado, guardado como base64 (MVP)
  createdAt   DateTime      @default(now())

  @@unique([contractId, period])
  @@index([tenantId])
  @@index([status])
}

// Documentación personal: DNI, nómina, contrato de trabajo. Ligada a un
// inquilino o a un comprador (nunca ambos a la vez).
model PersonDocument {
  id        String             @id @default(cuid())
  tenantId  String
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  renterId  String?
  renter    Renter?            @relation(fields: [renterId], references: [id], onDelete: Cascade)
  buyerId   String?
  buyer     Buyer?             @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  type      PersonDocumentType
  fileName  String
  fileData  String             // base64
  createdAt DateTime           @default(now())

  @@index([tenantId])
  @@index([renterId])
  @@index([buyerId])
}

// Documentación de la propiedad: escritura, etc.
model PropertyDocument {
  id         String               @id @default(cuid())
  tenantId   String
  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  type       PropertyDocumentType
  fileName   String
  fileData   String               // base64
  createdAt  DateTime             @default(now())

  @@index([tenantId])
  @@index([propertyId])
}

// Fotos de la propiedad y de las llaves (para identificar a qué propiedad
// corresponde cada llave si se pierde la etiqueta).
model PropertyPhoto {
  id         String            @id @default(cuid())
  tenantId   String
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  type       PropertyPhotoType
  label      String?           // ej: "Llave puerta principal"
  fileName   String
  fileData   String            // base64
  createdAt  DateTime          @default(now())

  @@index([tenantId])
  @@index([propertyId])
}
