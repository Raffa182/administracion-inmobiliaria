// Prisma schema - Gestión Inmobiliaria (multi-tenant)
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AGENTE
}

enum ContractStatus {
  ACTIVO
  FINALIZADO
  RESCINDIDO
}

// Larga temporada: alquiler habitual (LAU, mínimo de temporalidad legal).
// Temporada: alquiler vacacional/de corta duración.
enum ContractType {
  LARGA_TEMPORADA
  TEMPORADA
}

enum ExpenseType {
  IBI
  BASURA
  ARREGLO
  COMUNIDAD
  SEGURO
  OTRO
}

enum PaymentStatus {
  PENDIENTE
  PAGADO
  VENCIDO
}

enum ReservationStatus {
  ACTIVA
  CONVERTIDA
  CANCELADA
}

// Qué se hace con la propiedad: se ofrece en alquiler, en venta, o ambas.
enum ListingType {
  ALQUILER
  VENTA
  ALQUILER_Y_VENTA
}

enum SaleStatus {
  DISPONIBLE
  RESERVADA
  VENDIDA
  CANCELADA
}

// Documentación personal de un inquilino o comprador.
enum PersonDocumentType {
  DNI
  NOMINA
  CONTRATO_TRABAJO
  OTRO
}

// Documentación de la propiedad en sí (no ligada a una persona).
enum PropertyDocumentType {
  ESCRITURA
  OTRO
}

enum PropertyPhotoType {
  PROPIEDAD
  LLAVE
}

// Cada Tenant representa una inmobiliaria / cliente de la plataforma.
// El aislamiento de datos es lógico (tenantId en cada tabla); ver README
// para la estrategia de escalado a bases de datos físicas separadas.
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  users         User[]
  properties    Property[]
  renters       Renter[]
  owners        Owner[]
  buyers        Buyer[]
  contracts     Contract[]
  reservations  Reservation[]
  sales         Sale[]
  expenses      Expense[]
  payments      Payment[]
  personDocs    PersonDocument[]
  propertyDocs  PropertyDocument[]
  propertyPhotos PropertyPhoto[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  name         String
  role         Role     @default(ADMIN)
  emailVerified DateTime?
  createdAt    DateTime @default(now())

  @@unique([tenantId, email])
  @@index([email])
}

model Owner {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())

  properties Property[]

  @@index([tenantId])
}

model Renter {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  dni       String?
  email     String?
  phone     String?
  createdAt DateTime @default(now())

  contracts    Contract[]
  reservations Reservation[]
  documents    PersonDocument[]

  @@index([tenantId])
}

// Comprador de una propiedad en venta.
model Buyer {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  dni       String?
  email     String?
  phone     String?
  createdAt DateTime @default(now())

  sales     Sale[]
  documents PersonDocument[]

  @@index([tenantId])
}

// Ficha de la propiedad: datos que existen independientemente de que haya
// (o no) un contrato de alquiler o una venta en curso.
model Property {
  id          String      @id @default(cuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  address     String
  unit        String?
  city        String?
  type        String      @default("Piso")
  ownerId     String?
  owner       Owner?      @relation(fields: [ownerId], references: [id])

  listingType ListingType @default(ALQUILER)

  // Ficha
  squareMeters        Float?
  rooms               Int?
  petsAllowed         Boolean? // se aceptan mascotas
  appliancesIncluded  Boolean? // tiene electrodomésticos
  furnished           Boolean? // está equipada/amueblada
  hasParking          Boolean? // tiene plaza de parking
  inUrbanizacion      Boolean  @default(false)
  complexName         String?  // nombre de la urbanización, si aplica
  askingRent          Float?   // precio de alquiler pedido (ficha, antes de tener contrato)
  askingSale          Float?   // precio de venta pedido (ficha, antes de tener venta)
  notes               String?

  createdAt   DateTime @default(now())

  contracts     Contract[]
  reservations  Reservation[]
  sales         Sale[]
  expenses      Expense[]
  documents     PropertyDocument[]
  photos        PropertyPhoto[]

  @@index([tenantId])
}

// Reserva: paso previo al contrato de alquiler. Incluye una seña/honorario
// (normalmente el equivalente a una mensualidad) y, si se concreta, se
// convierte en un Contract.
model Reservation {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId  String
  property    Property          @relation(fields: [propertyId], references: [id])
  renterId    String
  renter      Renter            @relation(fields: [renterId], references: [id])

  reservationDate DateTime
  amount          Float         // seña / honorarios de la inmobiliaria
  status          ReservationStatus @default(ACTIVA)
  notes           String?

  contractId  String?  @unique
  contract    Contract? @relation(fields: [contractId], references: [id])

  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([propertyId])
}

// Alquiler
model Contract {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId  String
  property    Property       @relation(fields: [propertyId], references: [id])
  renterId    String
  renter      Renter         @relation(fields: [renterId], references: [id])

  contractType ContractType  @default(LARGA_TEMPORADA)

  startDate   DateTime
  endDate     DateTime
  rentAmount  Float
  // En España la actualización anual según IPC (INE) es lo habitual (LAU)
  adjustmentFrequencyMonths Int      @default(12)
  nextAdjustmentDate        DateTime?
  status      ContractStatus @default(ACTIVO)

  // Contrato digitalizado (PDF escaneado / firmado subido por el usuario)
  contractFileName String?
  contractFileData  String? // data URL / base64 (MVP: almacenado en DB; ver README para migrar a storage externo)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  expenses    Expense[]
  payments    Payment[]
  reservation Reservation?

  @@index([tenantId])
  @@index([propertyId])
  @@index([renterId])
}

// Venta de una propiedad.
model Sale {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId  String
  property    Property   @relation(fields: [propertyId], references: [id])
  buyerId     String?
  buyer       Buyer?     @relation(fields: [buyerId], references: [id])

  price       Float
  status      SaleStatus @default(DISPONIBLE)
  saleDate    DateTime?
  notes       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([propertyId])
}

// IBI, basura, arreglos, comunidad, etc. asociados a un contrato o
// directamente a una propiedad (también sirve para ventas, vía propertyId).
model Expense {
  id          String      @id @default(cuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contractId  String?
  contract    Contract?   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  propertyId  String?
  property    Property?   @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  type        ExpenseType
  description String
  amount      Float
  date        DateTime
  receiptFileName String?
  receiptFileData  String? // recibo escaneado (IBI, basura, etc.), base64

  createdAt   DateTime    @default(now())

  @@index([tenantId])
  @@index([contractId])
}

// Pago mensual de alquiler -> al marcarse PAGADO se genera un recibo en PDF
model Payment {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contractId  String
  contract    Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)

  period      String        // "2026-09"
  amount      Float
  dueDate     DateTime
  paidDate    DateTime?
  status      PaymentStatus @default(PENDIENTE)
  receiptFileName String?
  receiptFileData  String?  // PDF generado, guardado como base64 (MVP)
  createdAt   DateTime      @default(now())

  @@unique([contractId, period])
  @@index([tenantId])
  @@index([status])
}

// Documentación personal: DNI, nómina, contrato de trabajo. Ligada a un
// inquilino o a un comprador (nunca ambos a la vez).
model PersonDocument {
  id        String             @id @default(cuid())
  tenantId  String
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  renterId  String?
  renter    Renter?            @relation(fields: [renterId], references: [id], onDelete: Cascade)
  buyerId   String?
  buyer     Buyer?             @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  type      PersonDocumentType
  fileName  String
  fileData  String             // base64
  createdAt DateTime           @default(now())

  @@index([tenantId])
  @@index([renterId])
  @@index([buyerId])
}

// Documentación de la propiedad: escritura, etc.
model PropertyDocument {
  id         String               @id @default(cuid())
  tenantId   String
  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  type       PropertyDocumentType
  fileName   String
  fileData   String               // base64
  createdAt  DateTime             @default(now())

  @@index([tenantId])
  @@index([propertyId])
}

// Fotos de la propiedad y de las llaves (para identificar a qué propiedad
// corresponde cada llave si se pierde la etiqueta).
model PropertyPhoto {
  id         String            @id @default(cuid())
  tenantId   String
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  type       PropertyPhotoType
  label      String?           // ej: "Llave puerta principal"
  fileName   String
  fileData   String            // base64
  createdAt  DateTime          @default(now())

  @@index([tenantId])
  @@index([propertyId])
}
