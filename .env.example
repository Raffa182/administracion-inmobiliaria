DATABASE_URL="postgresql://usuario:contraseña@host:5432/inmobiliaria?schema=public"

# NextAuth / Auth.js
# Generar uno propio en producción: `npx auth secret`
AUTH_SECRET="reemplazar-por-un-secreto-largo-y-aleatorio"

# URL pública real de la app (con https si corresponde). La usa el portal
# del inquilino/comprador para armar el link del email de acceso — nunca
# se deriva de los headers de la request porque detrás de un proxy/túnel
# pueden traer un host/proto incorrecto.
APP_URL="https://tu-dominio-o-tunnel.com"

# SMTP genérico para enviar el link de acceso al portal. Sin esto
# configurado, el link se loguea en la consola del servidor en vez de
# enviarse (útil para probar sin tener todavía un proveedor elegido).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@tu-dominio.com"
